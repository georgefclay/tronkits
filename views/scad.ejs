<% var currentPage = 'utilities'; %>
<%- include('../partials/header') %>

<section class="tk-hero--tight" style="padding-bottom:28px">
  <div class="tk-breadcrumb">// HOME / TOOLBOX / OPENSCAD BOX GENERATOR</div>
  <h1 class="tk-h1" style="font-size:64px">Box generator.</h1>
  <p class="tk-lede" style="margin-top:12px; max-width:680px">
    Parametric box generator. Set dimensions, choose square or rounded corners, copy the OpenSCAD code — or render an STL on the server.
  </p>
</section>

<section class="tk-section-tight">
  <div class="tk-2col">
    <div class="tk-card-headed">
      <div class="tk-card-headed__head">
        <span>// INPUT · DIMENSIONS</span>
        <span class="yellow">MM</span>
      </div>
      <div class="tk-card-headed__body" style="padding:24px 26px">
        <div class="tk-calc-grid--2">
          <div class="tk-form-group">
            <label class="tk-label" for="width">// Width</label>
            <div class="tk-input-group">
              <input type="number" id="width" name="width" value="50" class="tk-input">
              <span class="tk-input-suffix">mm</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="length">// Length</label>
            <div class="tk-input-group">
              <input type="number" id="length" name="length" value="40" class="tk-input">
              <span class="tk-input-suffix">mm</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="height">// Height</label>
            <div class="tk-input-group">
              <input type="number" id="height" name="height" value="25" class="tk-input">
              <span class="tk-input-suffix">mm</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="wallThickness">// Wall thickness</label>
            <div class="tk-input-group">
              <input type="number" id="wallThickness" name="wallThickness" value="2" class="tk-input">
              <span class="tk-input-suffix">mm</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="lidThickness">// Lid thickness</label>
            <div class="tk-input-group">
              <input type="number" id="lidThickness" name="lidThickness" value="4" class="tk-input">
              <span class="tk-input-suffix">mm</span>
            </div>
          </div>
          <div class="tk-form-group" style="display:flex; align-items:flex-end">
            <label class="tk-check">
              <input type="checkbox" id="roundCorners" name="roundCorners">
              <span>Rounded corners</span>
            </label>
          </div>
        </div>

        <div class="tk-form-group" id="cornerRadiusDropdownWrapper" style="display:none; margin-top:18px; max-width:260px">
          <label class="tk-label" for="cornerRadiusDropdown">// Corner radius (mm)</label>
          <select id="cornerRadiusDropdown" class="tk-select">
            <option value="1">1</option>
            <option value="2" selected>2</option>
            <option value="3">3</option>
          </select>
        </div>

        <div class="tk-hero__btns" style="margin-top:24px; gap:10px">
          <button id="myButton" name="myButton" class="tk-btn tk-btn--accent">Generate OpenSCAD →</button>
          <button id="generateSTL" name="generateSTL" class="tk-btn tk-btn--ghost">Render STL ↓</button>
        </div>
        <div id="scadMsg" class="tk-status-msg"></div>
      </div>
    </div>

    <div class="tk-card-headed">
      <div class="tk-card-headed__head">
        <span>📄 box.scad</span>
        <span class="yellow">· OPENSCAD ·</span>
      </div>
      <div class="tk-card-headed__body" style="padding:0">
        <textarea id="output" class="tk-code-output" rows="22" spellcheck="false" placeholder="Generated code will appear here..."></textarea>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  function sq_box() {
    var sout = sbox.replace("{{w}}",  document.getElementById("width").value);
    sout = sout.replace("{{l}}",  document.getElementById("length").value);
    sout = sout.replace("{{h}}",  document.getElementById("height").value);
    sout = sout.replace("{{wt}}", document.getElementById("wallThickness").value);
    sout = sout.replace("{{lt}}", document.getElementById("lidThickness").value);
    document.getElementById("output").value = sout;
  }
  function rd_box() {
    var sout = rbox.replace("{{w}}",  document.getElementById("width").value);
    sout = sout.replace("{{l}}",  document.getElementById("length").value);
    sout = sout.replace("{{h}}",  document.getElementById("height").value);
    sout = sout.replace("{{wt}}", document.getElementById("wallThickness").value);
    sout = sout.replace("{{lt}}", document.getElementById("lidThickness").value);
    sout = sout.replace("{{cr}}", document.getElementById("cornerRadiusDropdown").value);
    document.getElementById("output").value = sout;
  }

  function showMsg(text, kind) {
    var m = document.getElementById("scadMsg");
    m.className = "tk-status-msg" + (kind ? " is-" + kind : "");
    m.textContent = text;
  }

  $('#myButton').click(function() {
    if ($('#roundCorners').is(':checked')) rd_box(); else sq_box();
    showMsg("OpenSCAD code generated.", "success");
  });
  $('#roundCorners').change(function() {
    $('#cornerRadiusDropdownWrapper').toggle($(this).is(':checked'));
  });

  $('#generateSTL').click(function () {
    const scadCode = document.getElementById("output").value;
    if (!scadCode.trim()) {
      showMsg("Generate OpenSCAD code first.", "warning");
      return;
    }
    showMsg("Rendering STL on server (may take up to 10 min)...", "warning");
    $.ajax({
      url: '/generate-stl',
      method: 'POST',
      contentType: 'application/json',
      data: JSON.stringify({ scad: scadCode }),
      success: function (res) {
        showMsg("STL ready. Downloading...", "success");
        window.location.href = res.url;
      },
      error: function () {
        showMsg("Failed to render STL.", "error");
      }
    });
  });

  var sbox = "// Parameters\n" +
    "w = {{w}};\n" +
    "l = {{l}};\n" +
    "h = {{h}};\n" +
    "wall_thickness = {{wt}};\n" +
    "lid_thickness = {{lt}};\n" +
    "lid_clearance = 0;\n\n" +
    "// Main box body\n" +
    "module box() {\n" +
    "    difference() {\n" +
    "        cube([w, l, h]);\n" +
    "        translate([wall_thickness, wall_thickness, wall_thickness])\n" +
    "            cube([w - 2 * wall_thickness, l - 2 * wall_thickness, h]);\n" +
    "    }\n" +
    "}\n\n" +
    "// Lid top\n" +
    "module top_l() {\n" +
    "    cube([w, l, lid_thickness/2]);\n" +
    "    translate([w*.5, l, 0])\n" +
    "    cube([10, 2, lid_thickness/2]);\n" +
    "}\n" +
    "// Lid bottom\n" +
    "module bottom_l() {\n" +
    "    difference() {\n" +
    "        cube([(w - (wall_thickness*2))- lid_clearance, (l - (wall_thickness*2))-lid_clearance, lid_thickness/2]);\n" +
    "        translate([wall_thickness, wall_thickness, 0])\n" +
    "        cube([(w - (wall_thickness*4)), (l - (wall_thickness*4)), (lid_thickness/2)+1]);\n" +
    "    }\n" +
    "}\n\n" +
    "box();\n\n" +
    "translate([w*1.1, 0, 0]) {\n" +
    "    top_l();\n" +
    "    translate([wall_thickness, wall_thickness, lid_thickness/2])\n" +
    "    bottom_l();\n" +
    "}\n";

  var rbox = "$fn = 100;\n" +
    "w = {{w}};\n" +
    "l = {{l}};\n" +
    "h = {{h}};\n" +
    "wall_thickness = {{wt}};\n" +
    "lid_thickness = {{lt}};\n" +
    "lid_clearance = 0;\n" +
    "rad = {{cr}};\n\n" +
    "module outer_rec() {\n" +
    "    linear_extrude(height = h)\n" +
    "    offset(r=rad) offset(delta = -1*rad) square([w, l]);\n" +
    "}\n\n" +
    "module inner_rec() {\n" +
    "    linear_extrude(height = h)\n" +
    "    offset(r=rad) offset(delta = -1*rad)\n" +
    "    square([w - (wall_thickness*2), l - (wall_thickness*2)]);\n" +
    "}\n\n" +
    "module top_l() {\n" +
    "    linear_extrude(height = lid_thickness/2)\n" +
    "    offset(r=rad) offset(delta = -1*rad) square([w, l]);\n" +
    "    translate([w*.5, l, 0])\n" +
    "    cube([10, 2, lid_thickness/2]);\n" +
    "}\n" +
    "module bottom_l() {\n" +
    "    difference() {\n" +
    "        linear_extrude(height = lid_thickness/2)\n" +
    "        offset(r=rad) offset(delta = -1*rad)\n" +
    "        square([(w - (wall_thickness*2))- lid_clearance, (l - (wall_thickness*2))-lid_clearance]);\n" +
    "        translate([wall_thickness, wall_thickness, 0])\n" +
    "        linear_extrude(height = (lid_thickness/2)+1)\n" +
    "        offset(r=rad) offset(delta = -1*rad)\n" +
    "        square([(w - (wall_thickness*4)), (l - (wall_thickness*4))]);\n" +
    "    }\n" +
    "}\n\n" +
    "difference() {\n" +
    "    outer_rec();\n" +
    "    translate([wall_thickness, wall_thickness, wall_thickness])\n" +
    "    inner_rec();\n" +
    "}\n\n" +
    "translate([w*1.1, 0, 0]) {\n" +
    "    top_l();\n" +
    "    translate([wall_thickness, wall_thickness, lid_thickness/2])\n" +
    "    bottom_l();\n" +
    "}\n";

  // expose to outer scope of script
  window.sbox = sbox;
  window.rbox = rbox;
});
</script>

<!-- ============================== EXPLAINER ============================== -->
<section class="tk-section">
  <div class="tk-section-head">
    <div class="tk-section-head__n">01</div>
    <div class="tk-section-head__body">
      <div class="tk-section-head__kicker">// How it works</div>
      <h2 class="tk-h2">From dimensions to a printable box</h2>
    </div>
    <div class="tk-section-head__rule"></div>
  </div>

  <div class="tk-prose" style="margin:0">
    <p>
      The box generator fills your dimensions into an OpenSCAD template and gives you the code:
      a hollow box with the wall thickness you set, plus a two-part lid (a flat top and an inner
      ring that sits inside the walls) placed next to it. Tick <em>Rounded corners</em> and the
      template switches to the <code>offset()</code> technique from the
      <a href="/tutorials/openscad-rounded-box">rounded box tutorial</a>, with a 1, 2 or
      3&nbsp;mm radius. All dimensions are outside measurements in millimetres.
    </p>
    <p>
      <strong>Two ways to finish.</strong> Copy the code into OpenSCAD on your own computer and
      render it there, or click <em>Render STL</em>. Rendering happens on the server: the code
      in the text box is sent to the Raspberry Pi that runs this site, OpenSCAD turns it into an
      STL, and your browser downloads it. The <code>.scad</code> and <code>.stl</code> files are
      saved on the server under a random file name and are not deleted automatically. Rendering
      can take a while; the server allows up to 10 minutes.
    </p>
    <p>
      <strong>Gotcha: the lid has zero clearance.</strong> The template sets
      <code>lid_clearance = 0</code>, so the lid's inner ring is exactly the size of the box's
      inner cavity. Most FDM printers need a small gap for parts to fit, so edit
      <code>lid_clearance</code> in the code box (0.2 to 0.4&nbsp;mm is a common starting point)
      before you render; whatever is in the box is what gets rendered.
    </p>
  </div>
</section>

<!-- ================================ FAQ ================================= -->
<%- include('../partials/tool_faq', {
  n: '02',
  faqs: [
    {
      "q": "Do I need OpenSCAD installed to use the box generator?",
      "a": "No. Click Render STL and the server renders the model with OpenSCAD and sends you the STL. You only need OpenSCAD if you want to render the code yourself or change the design further."
    },
    {
      "q": "What units does the box generator use?",
      "a": "Millimetres. Width, length and height are outside dimensions, and the inner cavity is the outside size minus two wall thicknesses."
    },
    {
      "q": "Is my design uploaded when I render an STL?",
      "a": "Yes. Rendering needs the server, so the OpenSCAD code is sent to it, and the .scad and .stl files are stored there under a random file name. Copying the code and rendering it in your own copy of OpenSCAD keeps everything local."
    },
    {
      "q": "Why doesn't the lid fit my box?",
      "a": "The generated code uses lid_clearance = 0, so the lid ring is the same size as the cavity. Increase lid_clearance in the code box, 0.2 to 0.4 mm is a common starting point for FDM printers, and render again."
    },
    {
      "q": "Can I edit the OpenSCAD code before rendering?",
      "a": "Yes. The code box is editable, and Render STL sends whatever is in it. That is the easiest way to change clearance, add holes or adjust the lid."
    },
    {
      "q": "Why use offset() instead of minkowski() for rounded corners?",
      "a": "Two offset() passes on a 2D square round the corners and then extrude to 3D, which renders much faster than minkowski() on a 3D shape and gives the same rounded outline for a box like this."
    }
  ],
  app: {
    "name": "TronKits OpenSCAD Box Generator",
    "path": "/scad",
    "applicationCategory": "DesignApplication",
    "description": "A free parametric box generator that writes OpenSCAD code for a box with a two-part lid, with square or rounded corners, and can render it to an STL file on the server. No login.",
    "featureList": [
      "Parametric width, length, height, wall and lid thickness",
      "Square or rounded corners (1, 2 or 3 mm radius)",
      "Generates editable OpenSCAD code",
      "Server-side STL rendering with OpenSCAD",
      "Two-part lid with a locating ring"
    ]
  }
}) %>

<%- include('../partials/footer') %>
