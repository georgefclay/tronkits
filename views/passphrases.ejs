<% locals.currentPage = 'utilities'; %>
<%- include('../partials/header') %>

<section class="tk-hero--tight" style="padding-bottom:28px">
  <div class="tk-breadcrumb">// HOME / TOOLBOX / PASSPHRASES</div>
  <h1 class="tk-h1" style="font-size:64px">Passphrases.</h1>
  <p class="tk-lede" style="margin-top:12px; max-width:680px">
    Memorable adjective → noun → verb → adverb passphrases, peppered with digits and symbols.
  </p>
</section>

<section class="tk-section-tight">
  <div class="tk-card" style="background:var(--paper-deep); margin-bottom:24px">
    <div class="tk-kicker" style="color:var(--green); margin-bottom:6px">// PRIVACY</div>
    <p class="tk-body" style="font-size:14px; margin:0">
      Generated on demand. TronKits does not store or log generated passphrases.
    </p>
  </div>

  <div class="tk-card-headed">
    <div class="tk-card-headed__head">
      <span>// CONTROLS</span>
      <span class="yellow">LENGTH ≥ 12</span>
    </div>
    <div class="tk-card-headed__body" style="padding:24px 26px">
      <div class="tk-calc-grid--3">
        <div class="tk-form-group">
          <label class="tk-label" for="length">// Length</label>
          <input id="length" type="number" class="tk-input" min="12" value="20">
        </div>
        <div class="tk-form-group">
          <label class="tk-label" for="count">// Count (1–50)</label>
          <input id="count" type="number" class="tk-input" min="1" max="50" value="10">
        </div>
        <div class="tk-form-group" style="display:flex; align-items:flex-end">
          <label class="tk-check">
            <input id="exact" type="checkbox">
            <span>Exact length</span>
          </label>
        </div>
      </div>

      <div style="margin-top:18px">
        <div class="tk-kicker" style="margin-bottom:8px">// PRESETS</div>
        <div class="tk-chip-row">
          <button type="button" class="tk-chip preset" data-len="12">12</button>
          <button type="button" class="tk-chip preset" data-len="16">16</button>
          <button type="button" class="tk-chip preset" data-len="20">20</button>
          <button type="button" class="tk-chip preset" data-len="24">24</button>
          <button type="button" class="tk-chip preset" data-len="32">32</button>
        </div>
      </div>

      <div class="tk-hero__btns" style="margin-top:24px; gap:10px">
        <button id="go" class="tk-btn tk-btn--accent" type="button">Generate →</button>
        <button id="copyAll" type="button" class="tk-btn tk-btn--ghost" disabled>Copy all</button>
        <button id="clear" type="button" class="tk-btn tk-btn--ghost" disabled>Clear</button>
      </div>
      <div id="status" class="tk-status-msg"></div>
    </div>
  </div>
</section>

<section class="tk-section-tight">
  <ul id="list" class="tk-row-list" style="display:none"></ul>
  <p class="tk-mono" style="margin-top:18px; color:var(--ink-soft); text-transform:none; letter-spacing:0.04em">
    Tip: use a password manager and avoid reusing passphrases across sites. <a href="/utility" style="color:var(--accent); text-decoration:underline">More utilities →</a>
  </p>
</section>

<script src="/js/passphrases.js"></script>

<!-- ============================== EXPLAINER ============================== -->
<section class="tk-section">
  <div class="tk-section-head">
    <div class="tk-section-head__n">01</div>
    <div class="tk-section-head__body">
      <div class="tk-section-head__kicker">// How it works</div>
      <h2 class="tk-h2">How these passphrases are built</h2>
    </div>
    <div class="tk-section-head__rule"></div>
  </div>

  <div class="tk-prose" style="margin:0">
    <p>
      The generator strings together real words in adjective → noun → verb → adverb order
      (repeating the pattern for longer phrases), randomly capitalizes some first letters, and
      puts a random digit or symbol between the words and at the end. It keeps adding words
      until the phrase is at least your length; <em>Exact length</em> retries until it lands on
      the length exactly. Every result has at least one capital, one digit and one symbol.
    </p>
    <p>
      <strong>Where it runs.</strong> Unlike most tools on this site, the passphrases are made
      on the server. The page calls <code>/api/passphrases</code> with only three settings
      (length, count and exact-length), a Python script on the server picks the words, and the
      list comes back to your browser. The passphrases aren't written to disk or a database.
      The server's access log records the request URL, which contains only those three
      settings. The API is limited to 30 requests a minute per IP address.
    </p>
    <p>
      <strong>How strong.</strong> The word lists hold 941 adjectives, 3,402 nouns, 1,485 verbs
      and 771 adverbs. Assuming an attacker knows exactly how the phrase was built, a four-word
      phrase carries about 66 bits of randomness: about 42 from the words, 21 from the four
      separators (each one of 35 characters) and up to 4 from capitalization. A three-word
      phrase is about 50 bits. More words is the cheapest way to add strength.
    </p>
    <p>
      <strong>Where the randomness comes from.</strong> Every choice (each word, separator and
      capital letter) is made with Python's <code>secrets</code> module, which draws from the
      operating system's cryptographically secure random number generator, the same source used
      for encryption keys. The one thing it can't change is that the phrase is created on a
      server you don't control, so for a password-manager master password or a disk-encryption
      key you may still prefer your password manager's own generator or dice-based Diceware.
    </p>
  </div>
</section>

<!-- ================================ FAQ ================================= -->
<%- include('../partials/tool_faq', {
  n: '02',
  faqs: [
    {
      "q": "Is the passphrase generator cryptographically secure?",
      "a": "Yes. Words, separators and capitalization are all chosen with Python's secrets module, which uses the operating system's cryptographically secure random number generator rather than the predictable random module."
    },
    {
      "q": "Are the generated passphrases stored or logged?",
      "a": "No. They are generated on the server, sent back to your browser and not saved. The server's access log records the request URL, which only contains the length, count and exact-length settings, never the passphrases."
    },
    {
      "q": "How long should a passphrase be?",
      "a": "Aim for 14 characters or more, and longer for important accounts such as email and banking. The generator defaults to 20 characters and won't go below 12."
    },
    {
      "q": "Is a passphrase stronger than a random password of the same length?",
      "a": "No. A 16-character password drawn at random from all 94 printable ASCII characters has about 105 bits of randomness, far more than a 16-character passphrase. The advantage of a passphrase is that it is easier to read, type and remember, so you can afford to make it longer."
    },
    {
      "q": "What does the Exact length option do?",
      "a": "Without it, the generator adds words until the phrase reaches at least your length, so results often run a few characters over. With it, the generator retries (sometimes using two-character separators) until the phrase is exactly the requested length."
    },
    {
      "q": "Can I generate several passphrases at once?",
      "a": "Yes. Set the count anywhere from 1 to 50, then copy a single passphrase or copy them all at once."
    },
    {
      "q": "Should I use the same passphrase on more than one site?",
      "a": "No. Use a different one for every site, because one breached site would otherwise unlock the others. A password manager makes that practical, and turning on multi-factor authentication adds another layer."
    }
  ],
  app: {
    "name": "TronKits Passphrase Generator",
    "path": "/passphrases",
    "applicationCategory": "SecurityApplication",
    "description": "A free passphrase generator that builds memorable adjective-noun-verb-adverb passphrases with digits, symbols and capitals mixed in, at a minimum or exact length, 1 to 50 at a time. No login.",
    "featureList": [
      "Adjective, noun, verb, adverb word pattern",
      "Digits and symbols between words, at least one capital",
      "Minimum or exact length from 12 to 128 characters",
      "Generate 1 to 50 at a time",
      "One-click copy or copy all",
      "Cryptographically secure randomness (Python secrets module)",
      "Passphrases are not stored or logged"
    ]
  }
}) %>

<%- include('../partials/footer') %>
