<% var currentPage = 'utilities'; %>
<%- include('../partials/header') %>

<section class="tk-hero--tight" style="padding-bottom:28px">
  <div class="tk-breadcrumb">// HOME / TOOLBOX / VOLTAGE DIVIDER</div>
  <h1 class="tk-h1" style="font-size:64px">Voltage divider.</h1>
  <p class="tk-lede" style="margin-top:12px; max-width:680px">
    Three of <code class="tk-inline">Vin</code>, <code class="tk-inline">Vout</code>, <code class="tk-inline">R1</code>, <code class="tk-inline">R2</code> solves the fourth. Toggle the load resistor option to factor in <code class="tk-inline">R_L</code>.
  </p>
</section>

<section class="tk-section-tight">
  <div class="tk-card-headed">
    <div class="tk-card-headed__head">
      <span>// INPUT · DIVIDER PARAMETERS</span>
      <span class="yellow" id="vdModeLabel">NO LOAD · 3 OF 4</span>
    </div>
    <div class="tk-card-headed__body" style="padding:24px 26px">
      <form id="vdForm" onsubmit="return false">
        <div style="margin-bottom:18px">
          <label class="tk-check">
            <input type="checkbox" id="useLoad">
            <span>Include load resistor (R_L)</span>
          </label>
        </div>

        <div class="tk-calc-grid">
          <div class="tk-form-group">
            <label class="tk-label" for="vin">// Vin</label>
            <div class="tk-input-group">
              <input type="number" step="any" id="vin" class="tk-input" placeholder="e.g. 12">
              <span class="tk-input-suffix">V</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="vout">// Vout</label>
            <div class="tk-input-group">
              <input type="number" step="any" id="vout" class="tk-input" placeholder="e.g. 5">
              <span class="tk-input-suffix">V</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="r1">// R1 (top)</label>
            <div class="tk-input-group">
              <input type="number" step="any" min="0" id="r1" class="tk-input" placeholder="e.g. 4.7">
              <select id="r1Unit" class="tk-select">
                <option value="1">Ω</option>
                <option value="1e3" selected>kΩ</option>
                <option value="1e6">MΩ</option>
              </select>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="r2">// R2 (bottom)</label>
            <div class="tk-input-group">
              <input type="number" step="any" min="0" id="r2" class="tk-input" placeholder="e.g. 10">
              <select id="r2Unit" class="tk-select">
                <option value="1">Ω</option>
                <option value="1e3" selected>kΩ</option>
                <option value="1e6">MΩ</option>
              </select>
            </div>
          </div>
          <div class="tk-form-group" id="rlWrap" style="display:none">
            <label class="tk-label" for="rl">// Load R_L</label>
            <div class="tk-input-group">
              <input type="number" step="any" min="0" id="rl" class="tk-input" placeholder="e.g. 47">
              <select id="rlUnit" class="tk-select">
                <option value="1">Ω</option>
                <option value="1e3" selected>kΩ</option>
                <option value="1e6">MΩ</option>
              </select>
            </div>
          </div>
        </div>

        <div class="tk-hero__btns" style="margin-top:24px; gap:10px">
          <button type="button" id="calcBtn" class="tk-btn tk-btn--accent">Calculate →</button>
          <button type="button" id="clearBtn" class="tk-btn tk-btn--ghost">Clear</button>
          <button type="button" id="copyLink" class="tk-btn tk-btn--ghost tk-btn--sm" style="align-self:center">Copy link</button>
        </div>
        <div id="msg" class="tk-status-msg"></div>
      </form>
    </div>
  </div>
</section>

<section class="tk-section-tight" id="detailsWrap" style="display:none">
  <div class="tk-2col">
    <div class="tk-card-headed tk-card-headed--ink">
      <div class="tk-card-headed__head">
        <span>// COMPUTED · RESULTS</span>
        <span>↻ LIVE</span>
      </div>
      <div class="tk-card-headed__body" style="padding:24px 26px">
        <ul class="tk-results-list" id="resultsList" style="color:var(--paper)"></ul>
      </div>
    </div>
    <div class="tk-card">
      <div class="tk-kicker tk-mb-18">// NOTES & FORMULAS</div>
      <div class="tk-formula"><code>Vout = Vin · R2 / (R1 + R2)</code></div>
      <div class="tk-formula"><code>R2′ = R2 ∥ R_L  (with load)</code></div>
      <div class="tk-formula"><code>R1 = R2 · (Vin/Vout − 1)</code></div>
      <div class="tk-formula"><code>R2 = R1 · Vout/(Vin − Vout)</code></div>
      <div class="tk-formula"><code>Vin = Vout · (R1 + R2)/R2</code></div>
      <p class="tk-body" style="font-size:13px; margin-top:14px">
        With load: solve <code class="tk-inline">R2′ = Vout·R1/(Vin − Vout)</code>, then recover R2 or R_L from
        <code class="tk-inline">R2 = R2′·R_L/(R_L − R2′)</code> / <code class="tk-inline">R_L = R2′·R2/(R2 − R2′)</code>.
      </p>
    </div>
  </div>
</section>

<script src="/js/share-link.js"></script>
<script>
(() => {
  // Field the last calculation filled in; kept out of the shareable URL so a
  // shared link still has the right number of inputs
  let lastSolved = null;
  const FIELDS = ["vin","vout","r1","r2","rl"];
  const UNITS = { r1:"r1Unit", r2:"r2Unit", rl:"rlUnit" };

  const getVal = (id, unitId=null) => {
    const el = document.getElementById(id);
    if (!el) return null;
    const raw = parseFloat(el.value);
    if (isNaN(raw)) return null;
    if (!unitId) return raw;
    const u = parseFloat(document.getElementById(unitId).value);
    return raw * u;
  };
  const setVal = (id, unitId, siValue) => {
    const unit = unitId ? parseFloat(document.getElementById(unitId).value) : 1;
    const num = siValue / unit;
    document.getElementById(id).value = Number.isFinite(num) ? num : "";
  };
  const showMsg = (text, type="error") => {
    const msg = document.getElementById("msg");
    msg.className = "tk-status-msg is-" + type;
    msg.textContent = text;
  };
  const clearMsg = () => { const m = document.getElementById("msg"); m.className="tk-status-msg"; m.textContent=""; };

  const pretty = (x, unit="") => {
    if (!Number.isFinite(x)) return "—";
    const exps = [
      {k:1e-12, s:"p"}, {k:1e-9, s:"n"}, {k:1e-6, s:"µ"}, {k:1e-3, s:"m"},
      {k:1, s:""}, {k:1e3, s:"k"}, {k:1e6, s:"M"}
    ];
    let best = exps.reduce((acc,e)=>{
      const v = x/e.k; return (Math.abs(v)>=1 && Math.abs(v)<1000 && Math.abs(v)<Math.abs(acc.v))?{v,s:e.s}:acc;
    }, {v:x, s:""});
    return (Math.abs(best.v)>=1000? x.toExponential(3): best.v.toFixed(3)) + (unit? " "+best.s+unit : "");
  };

  const calc = () => {
    clearMsg();
    document.getElementById("detailsWrap").style.display="none";

    const useLoad = document.getElementById("useLoad").checked;
    const vin_filled  = document.getElementById("vin").value.trim() !== "";
    const vout_filled = document.getElementById("vout").value.trim() !== "";
    const r1_filled   = document.getElementById("r1").value.trim() !== "";
    const r2_filled   = document.getElementById("r2").value.trim() !== "";
    const rl_filled   = document.getElementById("rl").value.trim() !== "";

    if (!useLoad) {
      if ((vin_filled + vout_filled + r1_filled + r2_filled) !== 3) {
        showMsg("Provide exactly three of Vin, Vout, R1, R2 (no load).");
        return;
      }
    } else {
      if ((vin_filled + vout_filled + r1_filled + r2_filled + rl_filled) !== 4) {
        showMsg("With load enabled, provide exactly four of Vin, Vout, R1, R2, RL.");
        return;
      }
    }

    let Vin = getVal("vin");
    let Vout = getVal("vout");
    let R1 = getVal("r1", "r1Unit");
    let R2 = getVal("r2", "r2Unit");
    let RL = useLoad ? getVal("rl", "rlUnit") : Infinity;

    try {
      if (!useLoad) {
        if (!vin_filled) {
          if (R1<=0 || R2<=0) throw new Error();
          Vin = Vout * (R1 + R2) / R2;
          setVal("vin", null, Vin);
        } else if (!vout_filled) {
          if (R1<=0 || R2<=0) throw new Error();
          Vout = Vin * R2 / (R1 + R2);
          setVal("vout", null, Vout);
        } else if (!r1_filled) {
          if (Vout===0) throw new Error();
          R1 = R2 * (Vin / Vout - 1);
          if (R1<=0) throw new Error();
          setVal("r1","r1Unit", R1);
        } else if (!r2_filled) {
          if (Vin - Vout === 0) throw new Error();
          R2 = R1 * Vout / (Vin - Vout);
          if (R2<=0) throw new Error();
          setVal("r2","r2Unit", R2);
        }
      } else {
        const R2eq_from_divider = () => {
          if (Vin - Vout === 0) throw new Error();
          return (Vout * R1) / (Vin - Vout);
        };

        if (!vin_filled) {
          const R2eq = (R2 && isFinite(RL)) ? (R2*RL)/(R2+RL) : R2eq_from_divider();
          Vin = Vout * (R1 + R2eq) / R2eq;
          setVal("vin", null, Vin);
        } else if (!vout_filled) {
          const R2eq = (R2 && isFinite(RL)) ? (R2*RL)/(R2+RL) : R2eq_from_divider();
          Vout = Vin * R2eq / (R1 + R2eq);
          setVal("vout", null, Vout);
        } else if (!r1_filled) {
          const R2eq = (R2 && isFinite(RL)) ? (R2*RL)/(R2+RL) : R2eq_from_divider();
          R1 = (Vin / Vout - 1) * R2eq;
          if (R1<=0) throw new Error();
          setVal("r1", "r1Unit", R1);
        } else if (!r2_filled) {
          const R2eq = R2eq_from_divider();
          if (!isFinite(RL)) throw new Error();
          const denom = (RL - R2eq);
          if (denom <= 0) throw new Error();
          R2 = (R2eq * RL) / denom;
          if (R2<=0) throw new Error();
          setVal("r2", "r2Unit", R2);
        } else if (!rl_filled) {
          const R2eq = R2eq_from_divider();
          const denom = (R2 - R2eq);
          if (denom <= 0) throw new Error();
          RL = (R2eq * R2) / denom;
          if (RL<=0) throw new Error();
          setVal("rl", "rlUnit", RL);
        }
      }
    } catch(e) {
      showMsg("Those values lead to an impossible result. Check units and ensure Vin > Vout > 0, resistances > 0.");
      return;
    }
    const filledMap = { vin:vin_filled, vout:vout_filled, r1:r1_filled, r2:r2_filled, rl:rl_filled };
    lastSolved = FIELDS.filter(id => useLoad || id !== "rl").find(id => !filledMap[id]);

    Vin = getVal("vin");
    Vout = getVal("vout");
    R1 = getVal("r1","r1Unit");
    R2 = getVal("r2","r2Unit");
    RL = useLoad ? getVal("rl","rlUnit") : Infinity;

    const R2eq = isFinite(RL) ? (R2*RL)/(R2+RL) : R2;
    const I_R2 = Vout / R2;
    const I_RL = isFinite(RL) ? Vout / RL : 0;
    const I_total = I_R2 + I_RL;
    const P_R1 = (I_total**2) * R1;
    const P_R2 = (I_R2**2) * R2;
    const P_RL = isFinite(RL) ? (I_RL**2) * RL : 0;

    const rows = [
      ['Effective R2 (R2′)', pretty(R2eq, 'Ω')],
      ['Vin', pretty(Vin, 'V')],
      ['Vout', pretty(Vout, 'V')],
      ['Current through R1', pretty(I_total, 'A')],
      ['Current through R2', pretty(I_R2, 'A')]
    ];
    if (isFinite(RL)) rows.push(['Current through RL', pretty(I_RL, 'A')]);
    rows.push(['Power in R1', pretty(P_R1, 'W')]);
    rows.push(['Power in R2', pretty(P_R2, 'W')]);
    if (isFinite(RL)) rows.push(['Power in RL', pretty(P_RL, 'W')]);

    const ul = document.getElementById("resultsList");
    ul.innerHTML = rows.map(r=>`<li><span>${r[0]}</span><strong>${r[1]}</strong></li>`).join("");
    document.getElementById("detailsWrap").style.display="";
    showMsg("Calculation complete.", "success");
  };

  const clearAll = () => {
    ["vin","vout","r1","r2","rl"].forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
    document.getElementById("r1Unit").value="1e3";
    document.getElementById("r2Unit").value="1e3";
    document.getElementById("rlUnit").value="1e3";
    document.getElementById("useLoad").checked=false;
    document.getElementById("rlWrap").style.display="none";
    document.getElementById("vdModeLabel").textContent="NO LOAD · 3 OF 4";
    clearMsg();
    document.getElementById("detailsWrap").style.display="none";
  };

  // Shareable URL (?vin=12&r1=4.7&r2=3.3, plus &l=1&rl=10 with a load)
  const syncUrl = () => {
    const useLoad = document.getElementById("useLoad").checked;
    const fields = { l: useLoad ? "1" : "" };
    FIELDS.forEach(id => {
      if (id === "rl" && !useLoad) return;
      if (id !== lastSolved) fields[id] = document.getElementById(id).value;
      if (UNITS[id]) {
        const unit = document.getElementById(UNITS[id]).value;
        if (unit !== "1e3") fields[id + "u"] = unit;
      }
    });
    TKShare.write(fields);
  };

  document.getElementById("useLoad").addEventListener("change", (e)=>{
    document.getElementById("rlWrap").style.display = e.target.checked ? "" : "none";
    document.getElementById("vdModeLabel").textContent = e.target.checked ? "WITH LOAD · 4 OF 5" : "NO LOAD · 3 OF 4";
    syncUrl();
  });
  document.getElementById("calcBtn").addEventListener("click", () => { calc(); syncUrl(); });
  document.getElementById("clearBtn").addEventListener("click", () => { clearAll(); lastSolved = null; syncUrl(); });
  FIELDS.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener("focus", () => { el.value=""; clearMsg(); if (id === lastSolved) lastSolved = null; syncUrl(); });
    if (el) el.addEventListener("input", syncUrl);
    if (UNITS[id]) document.getElementById(UNITS[id]).addEventListener("change", syncUrl);
  });

  // Pre-fill from the URL; solve straight away when the count is right
  const qs = TKShare.params();
  if (qs.get("l") === "1") {
    const cb = document.getElementById("useLoad");
    cb.checked = true;
    cb.dispatchEvent(new Event("change"));
  }
  FIELDS.forEach(id => {
    if (UNITS[id]) TKShare.setSelect(document.getElementById(UNITS[id]), qs.get(id + "u"));
    const v = TKShare.num(qs.get(id));
    if (v !== null) document.getElementById(id).value = v;
  });
  const useLoadNow = document.getElementById("useLoad").checked;
  const given = FIELDS.filter(id => (useLoadNow || id !== "rl") && document.getElementById(id).value !== "").length;
  if (given === (useLoadNow ? 4 : 3)) calc();
  if (qs.toString()) syncUrl(); // the load toggle above rewrote the URL early
  TKShare.bindCopy(document.getElementById("copyLink"));
})();
</script>

<!-- ============================== EXPLAINER ============================== -->
<section class="tk-section">
  <div class="tk-section-head">
    <div class="tk-section-head__n">01</div>
    <div class="tk-section-head__body">
      <div class="tk-section-head__kicker">// How it works</div>
      <h2 class="tk-h2">Voltage dividers, and why they sag</h2>
    </div>
    <div class="tk-section-head__rule"></div>
  </div>

  <div class="tk-prose" style="margin:0">
    <p>
      A voltage divider is two resistors in series across a supply; the point between them
      sits at a fixed fraction of the input voltage, set by the ratio of the resistors.
    </p>
    <p>
      <code>Vout = Vin × R2 / (R1 + R2)</code>. Anything connected to the output is in parallel
      with R2, so with a load the effective bottom resistor becomes
      <code>R2′ = R2 × RL / (R2 + RL)</code>.
    </p>
    <p>
      <strong>Example.</strong> 12&nbsp;V in, R1 = 4.7&nbsp;kΩ, R2 = 3.3&nbsp;kΩ:
      <code>12 × 3.3 / 8.0 = 4.95 V</code>. The divider draws 12&nbsp;V / 8&nbsp;kΩ =
      1.5&nbsp;mA and burns 18&nbsp;mW, so any ¼&nbsp;W resistors will do.
    </p>
    <p>
      <strong>Gotcha: the load is part of the divider.</strong> Hang a 10&nbsp;kΩ load on that
      output and R2′ drops to 2.48&nbsp;kΩ, pulling Vout from 4.95&nbsp;V down to 4.15&nbsp;V. A
      100&nbsp;kΩ load only pulls it to 4.86&nbsp;V. A common rule of thumb is to keep the load
      at least 10× R2. Dividers are for signals (ADC inputs, reference voltages, level-shifting
      a logic line), not for powering a board or a motor; use a regulator for that.
    </p>
  </div>
</section>

<!-- ================================ FAQ ================================= -->
<%- include('../partials/tool_faq', {
  n: '02',
  faqs: [
    {
      "q": "Can I use a voltage divider to power a device?",
      "a": "Not reliably. The output voltage depends on the load, so as the device draws more current the voltage sags, and the divider wastes power all the time. Use a linear regulator or a buck converter to power things; use dividers for signals and references."
    },
    {
      "q": "How do I get 3.3 V from 5 V with resistors?",
      "a": "R1 = 1 kΩ and R2 = 2 kΩ give 5 × 2 / 3 = 3.33 V. That works for stepping a 5 V logic signal down to a 3.3 V input, which draws almost no current. It is not a way to power a 3.3 V board."
    },
    {
      "q": "How do I choose between 1 kΩ and 100 kΩ resistors for the same ratio?",
      "a": "Low values hold their voltage better under load but waste more current; high values save current but sag more and pick up noise. For a microcontroller ADC input, check the datasheet's recommended source impedance; the ATmega328P, for example, is optimised for 10 kΩ or less."
    },
    {
      "q": "Why does my multimeter read a lower Vout than the calculator?",
      "a": "The meter itself is a load, typically about 10 MΩ. On a divider made of two 1 MΩ resistors that is enough to pull the output from 50% of Vin to about 47.6%. Resistor tolerance adds a few percent more."
    },
    {
      "q": "What does the load resistor option do?",
      "a": "It models a load RL in parallel with R2. Tick the box and enter any four of Vin, Vout, R1, R2 and RL; the calculator solves the fifth and shows the current and power in each resistor."
    }
  ],
  app: {
    "name": "TronKits Voltage Divider Calculator",
    "path": "/voltage-divider",
    "applicationCategory": "UtilitiesApplication",
    "description": "A free, browser-based voltage divider calculator: enter any three of Vin, Vout, R1 and R2 to solve the fourth, with an optional load resistor, currents and power dissipation. No login.",
    "featureList": [
      "Solve Vin, Vout, R1 or R2 from the other three",
      "Optional load resistor in parallel with R2",
      "Current through each resistor",
      "Power dissipated in each resistor",
      "Runs entirely in the browser"
    ]
  }
}) %>

<%- include('../partials/footer') %>
