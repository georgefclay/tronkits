    "featureList": [
      "Load a CSV locally by picking or dropping a file",
      "Column profiling: type, filled, blank and unique counts",
      "Per-column filters: ranges, checkboxes or text match",
      "Search and sort across all rows",
      "Record detail view for a single row",
      "Download filtered rows as CSV"
    ]
  }
}) %>

<%- include('../partials/footer.ejs') %>
