<% locals.currentPage = 'utilities'; %>
<%- include('../partials/header') %>

<section class="tk-hero--tight" style="padding-bottom:28px">
  <div class="tk-breadcrumb">// HOME / TOOLBOX / LED SERIES RESISTOR</div>
  <h1 class="tk-h1" style="font-size:64px">LED resistor.</h1>
  <p class="tk-lede" style="margin-top:12px; max-width:680px">
    Pick a supply, drop, and target current. Get the series resistor for N LEDs — plus power and a standard-value rounding.
  </p>
</section>

<section class="tk-section-tight">
  <div class="tk-card-headed">
    <div class="tk-card-headed__head">
      <span>// INPUT · LED + SUPPLY</span>
      <span class="yellow">ALL REQUIRED</span>
    </div>
    <div class="tk-card-headed__body" style="padding:24px 26px">
      <form id="ledForm" onsubmit="return false">
        <div class="tk-calc-grid">
          <div class="tk-form-group">
            <label class="tk-label" for="vs">// Supply Vs</label>
            <div class="tk-input-group">
              <input type="number" step="any" id="vs" class="tk-input" placeholder="e.g. 5">
              <span class="tk-input-suffix">V</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="vf">// Vf per LED</label>
            <div class="tk-input-group">
              <input type="number" step="any" id="vf" class="tk-input" placeholder="e.g. 2.0">
              <span class="tk-input-suffix">V</span>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="i">// LED current I</label>
            <div class="tk-input-group">
              <input type="number" step="any" id="i" class="tk-input" placeholder="e.g. 20">
              <select id="iUnit" class="tk-select">
                <option value="1">A</option>
                <option value="1e-3" selected>mA</option>
                <option value="1e-6">µA</option>
              </select>
            </div>
          </div>
          <div class="tk-form-group">
            <label class="tk-label" for="nled">// LEDs in series N</label>
            <input type="number" id="nled" min="1" step="1" value="1" class="tk-input">
          </div>
        </div>

        <div class="tk-form-group" style="margin-top:18px; max-width:380px">
          <label class="tk-label" for="esel">// Snap R to E-series (rounded up)</label>
          <select id="esel" class="tk-select">
            <option value="none" selected>None (exact value)</option>
            <option value="E12">E12 (±10%)</option>
            <option value="E24">E24 (±5%)</option>
          </select>
        </div>

        <div class="tk-hero__btns" style="margin-top:18px; gap:10px">
          <button type="button" id="calcBtn" class="tk-btn tk-btn--accent">Calculate →</button>
          <button type="button" id="clearBtn" class="tk-btn tk-btn--ghost">Clear</button>
          <button type="button" id="copyLink" class="tk-btn tk-btn--ghost tk-btn--sm" style="align-self:center">Copy link</button>
        </div>
        <div id="msg" class="tk-status-msg"></div>
      </form>
    </div>
  </div>
</section>

<section class="tk-section-tight" id="detailsWrap" style="display:none">
  <div class="tk-2col">
    <div class="tk-card-headed tk-card-headed--ink">
      <div class="tk-card-headed__head">
        <span>// COMPUTED · RESISTOR</span>
        <span>↻ LIVE</span>
      </div>
      <div class="tk-card-headed__body" style="padding:24px 26px">
        <ul class="tk-results-list" id="resultsList" style="color:var(--paper)"></ul>
      </div>
    </div>
    <div class="tk-card">
      <div class="tk-kicker tk-mb-18">// FORMULAS</div>
      <div class="tk-formula"><code>Vdrop = Vs − N·Vf</code></div>
      <div class="tk-formula"><code>R = Vdrop / I</code></div>
      <div class="tk-formula"><code>P_R = I² · R</code></div>
      <div class="tk-formula"><code>P_LEDs ≈ I · (N·Vf)</code></div>
      <p class="tk-body" style="font-size:13px; margin-top:14px">
        E-series rounding goes <strong>upwards</strong> to keep current at or below target. Suggested resistor wattage: ~2× actual dissipation.
      </p>
    </div>
  </div>
</section>

<section class="tk-section">
  <div class="tk-section-head">
    <div class="tk-section-head__n">02</div>
    <div class="tk-section-head__body">
      <div class="tk-section-head__kicker">// Reference</div>
      <h2 class="tk-h2">Typical Vf by LED color</h2>
    </div>
    <div class="tk-section-head__rule"></div>
  </div>

  <div class="tk-card" style="padding:0">
    <table class="tk-table" id="colorTable">
      <thead>
        <tr>
          <th>Color</th>
          <th>Vf (≈20 mA)</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
  <p class="tk-mono" style="margin-top:14px; color:var(--ink-soft); text-transform:none; letter-spacing:0.04em">
    Approximate values. Always verify with your LED's datasheet at your operating current and temperature.
  </p>
</section>

<script src="/js/share-link.js"></script>
<script src="/js/tk-format.js"></script>
<script>
(() => {
  const E12 = [1.0,1.2,1.5,1.8,2.2,2.7,3.3,3.9,4.7,5.6,6.8,8.2];
  // Standard IEC 60063 E24 decade (the previous list mixed in E48/E96 values)
  const E24 = [1.0,1.1,1.2,1.3,1.5,1.6,1.8,2.0,2.2,2.4,2.7,3.0,3.3,3.6,3.9,4.3,4.7,5.1,5.6,6.2,6.8,7.5,8.2,9.1];

  const getVal = (id, unitId=null) => {
    const el = document.getElementById(id);
    const raw = parseFloat(el.value);
    if (isNaN(raw)) return null;
    if (!unitId) return raw;
    const u = parseFloat(document.getElementById(unitId).value);
    return raw * u;
  };
  const showMsg = (t, type="error") => { const m=document.getElementById("msg"); m.className="tk-status-msg is-"+type; m.textContent=t; };
  const clearMsg = () => { const m=document.getElementById("msg"); m.className="tk-status-msg"; m.textContent=""; };


  const roundE = (R) => {
    const mode = document.getElementById("esel").value;
    if (mode === "none") return {value:R, series:"Exact"};
    const table = (mode==="E12") ? E12 : E24;
    const decade = Math.pow(10, Math.floor(Math.log10(R)));
    const norm = R/decade;
    let pick = table.find(v => v >= norm);
    let out = (pick !== undefined) ? pick*decade : table[0]*decade*10;
    return {value: out, series: mode};
  };

  function updateColorTable() {
    const tbody = document.querySelector('#colorTable tbody');
    if (!tbody) return;
    const colors = [
      {name:"Infrared", vf:1.20, color:'#7A4012'},
      {name:"Red",      vf:2.00, color:'#C9442C'},
      {name:"Orange",   vf:2.05, color:'#E25C2C'},
      {name:"Amber",    vf:2.10, color:'#E5B043'},
      {name:"Yellow",   vf:2.10, color:'#E5B043'},
      {name:"Green",    vf:2.20, color:'#2D8F60'},
      {name:"Cyan",     vf:3.10, color:'#5BAFC6'},
      {name:"Blue",     vf:3.20, color:'#2E6DA4'},
      {name:"White",    vf:3.20, color:'#F0EAD9'},
      {name:"UV",       vf:3.40, color:'#6B47B8'}
    ];
    tbody.innerHTML = colors.map(c => `
      <tr>
        <td><span class="swatch" style="background:${c.color}"></span><span style="font-weight:600">${c.name}</span></td>
        <td>${c.vf.toFixed(2)} V</td>
      </tr>
    `).join("");
  }

  const calc = () => {
    clearMsg();
    document.getElementById("detailsWrap").style.display="none";

    const Vs = getVal("vs");
    const Vf = getVal("vf");
    const I  = getVal("i","iUnit");
    const N  = parseInt(document.getElementById("nled").value || "1", 10);

    if (!Number.isFinite(Vs) || !Number.isFinite(Vf) || !Number.isFinite(I)) {
      showMsg("Please enter Vs, Vf, and I.", "warning");
      return;
    }
    if (I <= 0 || Vf <= 0 || N < 1) {
      showMsg("Ensure I > 0, Vf > 0, and N ≥ 1.");
      return;
    }

    const Vdrop = Vs - N*Vf;
    if (!Number.isFinite(Vdrop) || Vdrop <= 0) {
      showMsg("Vs must be greater than N·Vf to leave headroom for the resistor.");
      return;
    }

    const R_exact = Vdrop / I;
    const rounded = roundE(R_exact);
    const R_rec = rounded.value;
    const seriesName = rounded.series;

    const P_R = I*I*R_rec;
    const P_LED = I * (N*Vf);
    const wattSteps = [0.125, 0.25, 0.5, 1, 2];
    const recWatt = wattSteps.find(w => w >= P_R*2) || (P_R*2);

    const FRACTION_W = { 0.125: '⅛ W', 0.25: '¼ W', 0.5: '½ W' };
    const results = [
      ['Exact R',                fmtSI(R_exact, 'Ω')],
      [seriesName + ' rounded up', fmtSI(R_rec, 'Ω')],
      ['Voltage drop across R',  fmtSI(Vdrop, 'V')],
      ['Current',                fmtSI(I, 'A')],
      ['Power in R',             fmtSI(P_R, 'W')],
      ['Suggested wattage rating', '≥ ' + fmtSI(recWatt, 'W') + (FRACTION_W[recWatt] ? ' (' + FRACTION_W[recWatt] + ')' : '')],
      ['LEDs power (N=' + N + ')', fmtSI(P_LED, 'W')]
    ];

    document.getElementById("resultsList").innerHTML = results.map(r=>`<li><span>${r[0]}</span><strong>${r[1]}</strong></li>`).join("");
    document.getElementById("detailsWrap").style.display="";
    showMsg("Calculation complete.", "success");
  };

  const clearAll = () => {
    ["vs","vf","i"].forEach(id => document.getElementById(id).value="");
    document.getElementById("iUnit").value="1e-3";
    document.getElementById("nled").value="1";
    document.getElementById("esel").value="none";
    clearMsg();
    document.getElementById("detailsWrap").style.display="none";
  };

  // Shareable URL (?vs=12&vf=3.2&i=20&n=3); defaults are left out
  const syncUrl = () => {
    const iu = document.getElementById("iUnit").value;
    const n = document.getElementById("nled").value;
    const e = document.getElementById("esel").value;
    TKShare.write({
      vs: document.getElementById("vs").value,
      vf: document.getElementById("vf").value,
      i:  document.getElementById("i").value,
      iu: iu === "1e-3" ? "" : iu,
      n:  n === "1" ? "" : n,
      e:  e === "none" ? "" : e
    });
  };

  document.getElementById("calcBtn").addEventListener("click", () => { calc(); syncUrl(); });
  document.getElementById("clearBtn").addEventListener("click", () => { clearAll(); syncUrl(); });
  ["vs","vf","i","nled"].forEach(id => {
    const el = document.getElementById(id);
    el.addEventListener("focus", ()=>{ if (id!=="nled") el.value=""; clearMsg(); syncUrl(); });
    el.addEventListener("input", syncUrl);
  });
  ["iUnit","esel"].forEach(id => document.getElementById(id).addEventListener("change", syncUrl));

  // Pre-fill from the URL; calculate when the required inputs are there
  const qs = TKShare.params();
  [["vs","vs"],["vf","vf"],["i","i"]].forEach(([k,id]) => {
    const v = TKShare.num(qs.get(k));
    if (v !== null) document.getElementById(id).value = v;
  });
  const qn = qs.get("n");
  if (qn && /^\d+$/.test(qn) && Number(qn) >= 1) document.getElementById("nled").value = qn;
  TKShare.setSelect(document.getElementById("iUnit"), qs.get("iu"));
  TKShare.setSelect(document.getElementById("esel"), qs.get("e"));
  if (["vs","vf","i"].every(id => document.getElementById(id).value !== "")) calc();
  TKShare.bindCopy(document.getElementById("copyLink"));

  setTimeout(updateColorTable, 0);
})();
</script>

<!-- ============================== EXPLAINER ============================== -->
<section class="tk-section">
  <div class="tk-section-head">
    <div class="tk-section-head__n">03</div>
    <div class="tk-section-head__body">
      <div class="tk-section-head__kicker">// How it works</div>
      <h2 class="tk-h2">Sizing an LED resistor</h2>
    </div>
    <div class="tk-section-head__rule"></div>
  </div>

  <div class="tk-prose" style="margin:0">
    <p>
      An LED needs something to limit its current: above its forward voltage (Vf) a tiny
      increase in voltage makes the current shoot up. A series resistor drops whatever supply
      voltage the LEDs don't use, and that sets the current.
    </p>
    <p>
      <code>R = (Vs − N × Vf) / I</code> and the resistor dissipates
      <code>P = I² × R</code>.
    </p>
    <p>
      <strong>Example.</strong> Three white LEDs (Vf ≈ 3.2&nbsp;V each) in series on 12&nbsp;V at
      20&nbsp;mA: <code>(12 − 3 × 3.2) / 0.020 = 120 Ω</code>, which is a standard E12 value.
      The resistor dissipates <code>0.020² × 120 = 0.048 W</code> (the calculator shows
      48&nbsp;mW), and it suggests a rating of at least 125&nbsp;mW (⅛&nbsp;W), about twice the
      real dissipation.
    </p>
    <p>
      <strong>Gotcha: Vf isn't a constant.</strong> It varies by color (about 2.0&nbsp;V for red
      and 3.2&nbsp;V for blue or white, see the table above) and from part to part. In the
      example only 2.4&nbsp;V is left for the resistor, so if those LEDs are really 3.0&nbsp;V
      each the current rises to 25&nbsp;mA, and at 3.3&nbsp;V each it falls to 17.5&nbsp;mA.
      Leave more headroom (fewer LEDs per string) or use a constant-current driver when
      brightness has to match.
    </p>
  </div>
</section>

<!-- ================================ FAQ ================================= -->
<%- include('../partials/tool_faq', {
  n: '04',
  faqs: [
    {
      "q": "What resistor do I need for an LED on 5 V?",
      "a": "For a red LED (Vf about 2.0 V) at 20 mA: (5 − 2.0) / 0.020 = 150 Ω. For a blue or white LED (Vf about 3.2 V) at 20 mA: (5 − 3.2) / 0.020 = 90 Ω, so round up to the next standard value, 100 Ω."
    },
    {
      "q": "Can several LEDs in parallel share one resistor?",
      "a": "It's not a good idea. Small differences in forward voltage mean one LED takes more than its share of the current, runs brighter and hotter, and fails first. Give each LED, or each series string, its own resistor."
    },
    {
      "q": "Why round the resistor up to an E-series value?",
      "a": "Rounding up keeps the current at or below your target. In the 5 V blue LED example, 90 Ω rounds up to 100 Ω, which gives 1.8 V / 100 Ω = 18 mA instead of 20 mA, a difference you won't see."
    },
    {
      "q": "How much current should an LED get?",
      "a": "Check the datasheet. Many standard 5 mm indicator LEDs are rated around 20 mA continuous, and modern high-efficiency LEDs are often plenty bright at 5 to 10 mA, which also saves power."
    },
    {
      "q": "Does the resistor go on the anode or the cathode side?",
      "a": "Either. In a series circuit the same current flows through every part, so the resistor limits it equally well on either side of the LED."
    },
    {
      "q": "Can I run a white LED from 3.3 V with a resistor?",
      "a": "Barely. With a Vf around 3.2 V, only about 0.1 V is left across the resistor, so the current swings a lot with small changes in Vf or supply. Use a higher supply voltage or a constant-current LED driver."
    }
  ],
  app: {
    "name": "TronKits LED Series Resistor Calculator",
    "path": "/led-resistor",
    "applicationCategory": "UtilitiesApplication",
    "description": "A free, browser-based LED resistor calculator: enter supply voltage, forward voltage, current and number of LEDs in series to get the series resistor, its power dissipation, a suggested wattage and E12/E24 rounding. No login.",
    "featureList": [
      "Series resistor for 1 to N LEDs in series",
      "Power dissipated in the resistor with a suggested wattage rating",
      "Round up to E12 or E24 standard values",
      "Typical forward voltage by LED color",
      "Runs entirely in the browser"
    ]
  }
}) %>

